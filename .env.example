# Copy this file to .env and replace the password with a unique strong value.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Localhost-only by default. Keep this for local testing and use a TLS reverse proxy for public access.
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_HOST_PORT=3000
GF_SERVER_ROOT_URL=http://localhost:3000/

# Per-node incoming TCP connection cap. Tune only after load testing.
MINIKV_MAX_CONNECTIONS=1024

# Required only for public profile: point this DNS name to the VM's public IP.
GRAFANA_DOMAIN=

# WAL segment rotation threshold (64 MiB). Older segments are retained until snapshot-safe cleanup exists.
MINIKV_WAL_SEGMENT_BYTES=67108864

# Bind published MiniKV client ports to loopback by default. Do not use 0.0.0.0
# unless the network is private and protected by a firewall/VPN.
MINIKV_NODE_A_BIND_ADDRESS=127.0.0.1
MINIKV_NODE_B_BIND_ADDRESS=127.0.0.1
MINIKV_NODE_C_BIND_ADDRESS=127.0.0.1
