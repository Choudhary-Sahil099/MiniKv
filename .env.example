# Copy this file to .env and replace the password with a unique strong value.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_TO_A_UNIQUE_STRONG_PASSWORD
# Localhost-only by default. Keep this for local testing and use a TLS reverse proxy for public access.
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_HOST_PORT=3001
GF_SERVER_ROOT_URL=http://localhost:3000/

# Required only for public profile: point this DNS name to the VM's public IP.
GRAFANA_DOMAIN=metrics.example.com
